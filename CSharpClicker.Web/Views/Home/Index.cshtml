@model IndexViewModel

@section styles {
    <link href="@Url.Content("~/css/index.css")" rel="stylesheet">
<style>
    body {
        background-image: url('./background.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
</style>
}

<div class="row">

    <div class="col">
        <div>
            <h3>Добро пожаловать в колонию, @Model.User.UserName</h3>
            <h4>У тебя уже накоплено <span id="current_score">@Model.User.CurrentScore</span> кусков руды</h4>
            <h4>Всего ты добыл <span id="record_score">@Model.User.RecordScore</span> кусков руды</h4>
            <h4>С одного удара киркой ты добываешь <span id="profit_per_click">@Model.User.ProfitPerClick</span> кусков</h4>
            <h4>Твои подчиненные ежесекундно добывают <span id="profit_per_second">@Model.User.ProfitPerSecond</span> кусков</h4>
        </div>
    </div>

    <div class="col justify-content-center" id="movement-container" style="position: relative; width: 400px; height: 400px; border: 1px solid white;">
        <button id="clickitem" class="click-item bg-transparent border-0" style="position: absolute; width: 200px; height: 200px; background-image: url('./Астероид.png'); background-size: cover; background-position: center; border-radius: 50px">
        </button>
    </div>

    <div class="col">
        <form asp-action="Logout" asp-controller="Auth">
            <input type="submit" class="btn btn-primary" value="Выйти из аккаунта" />
        </form>
        <h3>Бусты</h3>
        <div class="d-flex">
            @foreach (var boost in Model.Boosts)
            {
                var userBoost = Model.User.UserBoosts.FirstOrDefault(ub => ub.BoostId == boost.Id);

                var price = userBoost?.CurrentPrice ?? boost.Price;
                var quantity = userBoost?.Quantity ?? 0;

                <button class="boost-button border-0 bg-secondary m-3">
                    <span class="boost-id" hidden>@boost.Id</span>
                    <h4>@boost.Title</h4>
                    <img src="data:image/png;base64, @Convert.ToBase64String(boost.Image)" height="100" />
                    <h5 class="boost-price-string">Цена: <span class="boost-price">@price</span></h5>
                    <h5>
                        Доход: @boost.Profit
                        @if (boost.IsAuto)
                        {
                            <span> в секунду</span>
                        }
                    </h5>
                    <h5>
                        Количество приобретенных бустов: <span class="boost-quantity">@quantity</span>
                    </h5>
                </button>
            }
        </div>
    </div>
</div>

@section scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/index.js"></script>
    <script>
        $(document).ready(function() {
            var container = $('#movement-container');
            var button = $('#clickitem');
            var containerWidth = container.width();
            var containerHeight = container.height();
            var buttonWidth = button.width();
            var buttonHeight = button.height();
            var maxRecordScore = 30_000;
            var initialSize = 200; // Initial size of the button in pixels

            function moveButton() {
                var maxX = containerWidth - buttonWidth;
                var maxY = containerHeight - buttonHeight;
                var newX = Math.floor(Math.random() * maxX);
                var newY = Math.floor(Math.random() * maxY);
                button.css('transition', 'left 0.5s linear, top 0.5s linear');
                button.css({ left: newX + 'px', top: newY + 'px' });
            }

            function resizeButton() {
                var recordScore = parseInt($('#record_score').text());
                if (recordScore >= maxRecordScore) {
                    button.hide();
                    container.append('<div id="game-over" style="position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px;">Вы прошли игру</div>');
                    $('#current_score').parent().hide();
                    $('#record_score').parent().hide();
                    $('#profit_per_click').parent().hide();
                    $('#profit_per_second').parent().hide();
                } else {
                    var newSize = initialSize * (1 - (recordScore / maxRecordScore));
                    newSize = Math.max(newSize, 0); // Ensure the size does not go below 0
                    button.css({ width: newSize + 'px', height: newSize + 'px' });
                }
            }

            setInterval(moveButton, 500); // Move the button every 0.5 seconds
            setInterval(resizeButton, 100); // Check and resize the button every 0.1 seconds
        });
    </script>
}